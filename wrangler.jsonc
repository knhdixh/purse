{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "purse",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-22",
  // Keep the *.workers.dev address; per-version preview URLs aren't needed.
  "workers_dev": true,
  "routes": [{ "pattern": "purse.knhdixh.com", "custom_domain": true }],
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything goes through the Worker first so workers.dev can redirect to the canonical host.
    "run_worker_first": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "purse", "database_id": "84b4a6f5-0f0a-43f1-a9b3-0d3bc1e3550a", "migrations_dir": "migrations" }
  ],
  "vars": { "APP_NAME": "purse", "GEMINI_MODEL": "gemini-3.5-flash-lite", "CANONICAL_HOST": "purse.knhdixh.com" }
}
